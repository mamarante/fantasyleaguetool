# Copy this file to .env and fill in your own values. Never commit .env.

# --- ESPN (Grossi's ESPN 12-man league) ---
# Get these from your browser: log into espn.com, open DevTools -> Application -> Cookies -> espn.com
ESPN_SWID={xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
ESPN_S2=

# --- Yahoo (10-man league) ---
# Register a free app at https://developer.yahoo.com/apps/ (Fantasy Sports READ permission only)
# These are named to match yfpy's own env var convention (YAHOO_CONSUMER_KEY/SECRET).
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=
